# Copy to backend/.env and set your own credentials. Never commit backend/.env.
FRED_API_KEY=
COINGECKO_API_KEY=
FINNHUB_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Optional: omit DATABASE_URL to use backend/insightpulse.db.
# DATABASE_URL=postgresql+psycopg://user:password@localhost/insightpulse
# Public site address allowed to call this API. Comma-separate more than one.
# Leave empty when the site and API share one address.
# FRONTEND_ORIGIN=https://your-site.example
# Required in the X-Admin-Token header for debug, ingestion, live market download, and refresh.
# Leave empty to keep those routes closed.
# ADMIN_TOKEN=
